<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/estilos.css" prefHeight="600.0" prefWidth="900.0" styleClass="vista-modulo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gimnasio.gympjv.MiQRController">

    <children>
        <VBox alignment="CENTER" spacing="16.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="32.0" right="32.0" top="22.0" />
            </padding>
            <children>
                <Label styleClass="titulo-vista" text="Mi codigo QR" />

                <Label fx:id="lblNombre" styleClass="campo-valor-dorado" text="-" />

                <VBox alignment="CENTER" spacing="10.0" styleClass="card-oscura">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <ImageView fx:id="imgQR" fitHeight="240.0" fitWidth="240.0"
                                   pickOnBounds="true" preserveRatio="true" styleClass="qr-image" />
                        <Label fx:id="lblQrCode" styleClass="campo-valor" text="-" />
                        <Label fx:id="lblEstadoAcceso" styleClass="campo-valor-dorado" text="-" />
                    </children>
                </VBox>

                <Label styleClass="info-texto"
                       text="Muestra este codigo en la entrada del gimnasio para acceder."
                       wrapText="true" />
            </children>
        </VBox>

        <Label styleClass="marca-agua" text="Ayoub Atidi Belbaz"
               AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
