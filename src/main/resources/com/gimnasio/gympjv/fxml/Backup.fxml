<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/estilos.css" prefHeight="600.0" prefWidth="900.0" styleClass="vista-modulo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gimnasio.gympjv.BackupController">

    <children>
        <VBox spacing="14.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="titulo-vista" text="Copia de Seguridad" />

                <Label fx:id="lblCarpeta" styleClass="kpi-detalle" text="Carpeta: -" />

                <TextArea fx:id="txtLog" editable="false" prefHeight="380.0"
                          promptText="Log de operaciones..." VBox.vgrow="ALWAYS" />

                <HBox spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onExportar"
                                styleClass="btn-primary"   text="Exportar datos (CSV)" />
                        <Button mnemonicParsing="false" onAction="#onImportar"
                                styleClass="btn-secondary" text="Importar socios (CSV)" />
                        <Button mnemonicParsing="false" onAction="#onLimpiarLog"
                                styleClass="btn-secondary" text="Limpiar log" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label styleClass="marca-agua" text="Ayoub Atidi Belbaz"
               AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
