<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/estilos.css" prefHeight="600.0" prefWidth="900.0" styleClass="vista-modulo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gimnasio.gympjv.SociosController">

    <children>
        <VBox spacing="14.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <children>
                <Label styleClass="titulo-vista" text="Gestion de Socios" />

                <TableView fx:id="tablaSocios" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"
                                     prefWidth="80.0"
                                     text="ID" />
                        <TableColumn fx:id="colNombre"
                                     prefWidth="180.0"
                                     text="Nombre" />
                        <TableColumn fx:id="colTelefono"
                                     prefWidth="100.0"
                                     text="Telefono" />
                        <TableColumn fx:id="colEmail"
                                     prefWidth="180.0"
                                     text="Email" />
                        <!-- colQrCode oculta -->
                        <TableColumn fx:id="colQrCode"
                                     prefWidth="0.0"
                                     visible="false" text="" />
                        <TableColumn fx:id="colPuntos"
                                     prefWidth="70.0"
                                     text="Puntos" />
                        <TableColumn fx:id="colCuota"
                                     prefWidth="90.0"
                                     text="Cuota" />
                        <TableColumn fx:id="colEstado"
                                     prefWidth="80.0"
                                     text="Estado" />
                    </columns>
                </TableView>

                <HBox spacing="10.0" styleClass="action-bar">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onAlta"
                                styleClass="btn-primary"   text="Alta socio" />
                        <Button mnemonicParsing="false" onAction="#onModificar"
                                styleClass="btn-secondary" text="Modificar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onBaja"
                                styleClass="btn-danger"    text="Dar de baja" />
                    </children>
                </HBox>

                <Label styleClass="hint-tabla"
                       text="Selecciona un socio en la tabla para modificarlo o darlo de baja." />
            </children>
        </VBox>

        <Label styleClass="marca-agua" text="Ayoub Atidi Belbaz"
               AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
