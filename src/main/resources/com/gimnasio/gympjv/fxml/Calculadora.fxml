                    <font><Font size="18.0" /></font>
                </Button>
                <Button fx:id="botonCoseno" layoutX="98.0" layoutY="100.0" mnemonicParsing="false" onAction="#pulsarFuncion" prefHeight="55.0" prefWidth="86.0" styleClass="btn-secondary" text="cos" userData="cos">
