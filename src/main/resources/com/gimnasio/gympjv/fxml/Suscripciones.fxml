<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/estilos.css" prefHeight="600.0" prefWidth="900.0" styleClass="vista-modulo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gimnasio.gympjv.SuscripcionesController">

    <children>
        <VBox spacing="14.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <children>
                <Label styleClass="titulo-vista" text="Suscripciones" />

                <TableView fx:id="tablaSuscripciones" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"      prefWidth="90.0"  text="ID" />
                        <TableColumn fx:id="colTipo"    prefWidth="140.0" text="Tipo" />
                        <TableColumn fx:id="colImporte" prefWidth="100.0" text="Importe" />
                        <TableColumn fx:id="colInicio"  prefWidth="130.0" text="Inicio" />
                        <TableColumn fx:id="colFin"     prefWidth="130.0" text="Fin" />
                        <TableColumn fx:id="colEstado"  prefWidth="130.0" text="Estado" />
                    </columns>
                </TableView>

                <HBox spacing="10.0" styleClass="action-bar">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onNuevaSuscripcion"
                                styleClass="btn-primary"   text="Nueva suscripcion" />
                        <Button mnemonicParsing="false" onAction="#onRenovar"
                                styleClass="btn-secondary" text="Renovar" />
                        <Button mnemonicParsing="false" onAction="#onPagarMensualidad"
                                styleClass="btn-secondary" text="Pagar mensualidad" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onCancelar"
                                styleClass="btn-danger"    text="Cancelar" />
                    </children>
                </HBox>

                <Label styleClass="hint-tabla"
                       text="Selecciona una suscripcion para renovarla, registrar un pago o cancelarla." />
            </children>
        </VBox>

        <Label styleClass="marca-agua" text="Ayoub Atidi Belbaz"
               AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
