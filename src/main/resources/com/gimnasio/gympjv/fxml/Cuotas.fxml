<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/estilos.css"
            prefHeight="600.0" prefWidth="900.0"
            styleClass="vista-modulo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gimnasio.gympjv.CuotasController">

    <children>
        <VBox spacing="12.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>

            <Label styleClass="titulo-vista" text="Gestion de Cuotas" />

            <!-- ── Cuerpo: dos columnas (tabla ~60% / formulario ~40%) ── -->
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                <!-- ── Columna izquierda: tabla ────────────────────────── -->
                <TableView fx:id="tabla"
                           HBox.hgrow="ALWAYS"
                           minWidth="360.0">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId"
                                     prefWidth="90.0" text="ID Susc." />
                        <TableColumn fx:id="colSocio"
                                     prefWidth="160.0" text="Socio" />
                        <TableColumn fx:id="colTipo"
                                     prefWidth="90.0" text="Tipo" />
                        <TableColumn fx:id="colImporte"
                                     prefWidth="100.0" text="Importe" />
                        <TableColumn fx:id="colFechaFin"
                                     prefWidth="100.0" text="Vence" />
                        <TableColumn fx:id="colEstado"
                                     prefWidth="90.0" text="Estado" />
                    </columns>
                </TableView>

                <!-- ── Columna derecha: formulario ─────────────────────── -->
                <VBox spacing="8.0"
                      prefWidth="320.0"
                      minWidth="300.0"
                      maxWidth="360.0">

                    <Label styleClass="subtitulo-vista" text="Detalle de la suscripcion" />

                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label prefWidth="100.0" text="ID Susc.:" />
                        <TextField fx:id="campoId"
                                   HBox.hgrow="ALWAYS"
                                   editable="false"
                                   styleClass="campo-readonly" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label prefWidth="100.0" text="ID Socio:" />
                        <TextField fx:id="campoSocioId" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label prefWidth="100.0" text="Tipo:" />
                        <TextField fx:id="campoTipo"
                                   HBox.hgrow="ALWAYS"
                                   promptText="Mensual / Trimestral / Anual" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label prefWidth="100.0" text="Importe EUR:" />
                        <TextField fx:id="campoImporte" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label prefWidth="100.0" text="F. inicio:" />
                        <TextField fx:id="campoFechaInicio"
                                   HBox.hgrow="ALWAYS"
                                   promptText="AAAA-MM-DD" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label prefWidth="100.0" text="F. fin:" />
                        <TextField fx:id="campoFechaFin"
                                   HBox.hgrow="ALWAYS"
                                   promptText="AAAA-MM-DD" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label prefWidth="100.0" text="Clases incl.:" />
                        <TextField fx:id="campoClases" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label prefWidth="100.0" text="Estado:" />
                        <TextField fx:id="campoEstado"
                                   HBox.hgrow="ALWAYS"
                                   editable="false"
                                   styleClass="campo-readonly" />
                    </HBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Navegacion paginada -->
                    <HBox spacing="6.0" alignment="CENTER_LEFT">
                        <Button mnemonicParsing="false"
                                onAction="#onPrimero"
                                styleClass="btn-secondary" text="|&lt;" />
                        <Button mnemonicParsing="false"
                                onAction="#onAnterior"
                                styleClass="btn-secondary" text="&lt;" />
                        <Button mnemonicParsing="false"
                                onAction="#onSiguiente"
                                styleClass="btn-secondary" text="&gt;" />
                        <Button mnemonicParsing="false"
                                onAction="#onUltimo"
                                styleClass="btn-secondary" text="&gt;|" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="campoRegistro"
                               styleClass="hint-tabla"
                               text="Registro 0 / 0" />
                    </HBox>

                    <!-- Acciones CRUD -->
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Button mnemonicParsing="false"
                                onAction="#onNuevo"
                                styleClass="btn-secondary"
                                text="Nuevo" />
                        <Button mnemonicParsing="false"
                                onAction="#onGuardar"
                                styleClass="btn-primary"
                                text="Guardar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false"
                                onAction="#onEliminar"
                                styleClass="btn-danger"
                                text="Eliminar" />
                    </HBox>

                    <!-- Accion principal del modulo -->
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Button mnemonicParsing="false"
                                onAction="#onCobrarCuota"
                                styleClass="btn-primary"
                                text="Cobrar cuota" />
                    </HBox>

                    <Label fx:id="campoMensaje"
                           styleClass="hint-tabla" text="" wrapText="true" />
                </VBox>
            </HBox>
        </VBox>

        <Label styleClass="marca-agua"
               text="Ayoub Atidi Belbaz"
               AnchorPane.bottomAnchor="6.0"
               AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
