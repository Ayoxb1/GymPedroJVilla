<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/estilos.css"
            prefHeight="640.0" prefWidth="900.0"
            styleClass="vista-modulo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gimnasio.gympjv.ClasesController">

    <children>
        <VBox spacing="10.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="16.0" left="24.0"
                        right="24.0" top="16.0" />
            </padding>
            <children>
                <Label styleClass="titulo-vista"
                       text="Clases grupales" />

                <!-- Tabla de clases -->
                <TableView fx:id="tablaClases"
                           prefHeight="200.0">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId"
                                     prefWidth="80.0"
                                     text="ID" />
                        <TableColumn fx:id="colNombre"
                                     prefWidth="160.0"
                                     text="Nombre" />
                        <TableColumn fx:id="colFecha"
                                     prefWidth="150.0"
                                     text="Fecha" />
                        <TableColumn fx:id="colMonitor"
                                     prefWidth="140.0"
                                     text="Monitor" />
                        <TableColumn fx:id="colOcupacion"
                                     prefWidth="80.0"
                                     text="Inscritos" />
                        <TableColumn fx:id="colAforo"
                                     prefWidth="70.0"
                                     text="Aforo" />
                    </columns>
                </TableView>

                <HBox spacing="10.0">
                    <Button mnemonicParsing="false"
                            onAction="#onNueva"
                            styleClass="btn-primary"
                            text="Nueva clase" />
                    <Button mnemonicParsing="false"
                            onAction="#onCancelarClase"
                            styleClass="btn-danger"
                            text="Cancelar clase" />
                </HBox>

                <!-- Calendario semanal -->
                <Label styleClass="kpi-titulo"
                       text="Calendario semanal" />

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            prefHeight="240.0">
                    <GridPane fx:id="calendarioSemana"
                              hgap="6.0" vgap="6.0"
                              styleClass="calendario-grid">
                        <padding>
                            <Insets bottom="8.0" left="8.0"
                                    right="8.0" top="8.0" />
                        </padding>
                        <columnConstraints>
                            <ColumnConstraints
                                percentWidth="14.3" />
                            <ColumnConstraints
                                percentWidth="14.3" />
                            <ColumnConstraints
                                percentWidth="14.3" />
                            <ColumnConstraints
                                percentWidth="14.3" />
                            <ColumnConstraints
                                percentWidth="14.3" />
                            <ColumnConstraints
                                percentWidth="14.3" />
                            <ColumnConstraints
                                percentWidth="14.2" />
                        </columnConstraints>
                    </GridPane>
                </ScrollPane>

            </children>
        </VBox>

        <Label styleClass="marca-agua"
               text="Ayoub Atidi Belbaz"
               AnchorPane.bottomAnchor="6.0"
               AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
