<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/estilos.css" prefHeight="600.0" prefWidth="900.0" styleClass="vista-modulo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gimnasio.gympjv.StockController">

    <children>
        <VBox spacing="14.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <children>
                <Label styleClass="titulo-vista" text="Stock e inventario" />

                <TableView fx:id="tablaStock" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"      prefWidth="90.0"  text="ID" />
                        <TableColumn fx:id="colNombre"  prefWidth="260.0" text="Producto" />
                        <TableColumn fx:id="colPrecio"  prefWidth="100.0" text="Precio EUR" />
                        <TableColumn fx:id="colStock"   prefWidth="90.0"  text="Stock" />
                        <TableColumn fx:id="colMinimo"  prefWidth="90.0"  text="Minimo" />
                    </columns>
                </TableView>

                <HBox spacing="10.0" styleClass="action-bar">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onNuevo"
                                styleClass="btn-primary"   text="Nuevo producto" />
                        <Button mnemonicParsing="false" onAction="#onReponer"
                                styleClass="btn-secondary" text="Reponer stock" />
                        <Button mnemonicParsing="false" onAction="#onAlertas"
                                styleClass="btn-warning"   text="Ver alertas" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onEliminar"
                                styleClass="btn-danger"    text="Eliminar" />
                    </children>
                </HBox>

                <Label styleClass="hint-tabla"
                       text="Productos con stock por debajo del minimo aparecen en Alertas." />
            </children>
        </VBox>

        <Label styleClass="marca-agua" text="Ayoub Atidi Belbaz"
               AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
