<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/estilos.css" prefHeight="600.0" prefWidth="900.0" styleClass="vista-modulo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gimnasio.gympjv.AccesoQRController">

    <children>
        <VBox alignment="CENTER" spacing="14.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="titulo-vista" text="Acceso por QR" />

                <Label styleClass="info-texto"
                       text="Genera el QR de un socio o lee uno existente para validar el acceso."
                       wrapText="true" />

                <ImageView fx:id="imgQR" fitHeight="240.0" fitWidth="240.0"
                           pickOnBounds="true" preserveRatio="true" styleClass="qr-image" />

                <Label fx:id="lblResultado" styleClass="resultado-qr" text="" wrapText="true" />

                <HBox alignment="CENTER" spacing="14.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onGenerar"
                                styleClass="btn-primary" text="Generar QR de socio" />
                        <Button mnemonicParsing="false" onAction="#onLeer"
                                styleClass="btn-secondary" text="Leer QR de fichero" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label styleClass="marca-agua" text="Ayoub Atidi Belbaz"
               AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="14.0" />
    </children>
</AnchorPane>
