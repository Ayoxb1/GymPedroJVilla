<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" prefHeight="700.0" prefWidth="1100.0" styleClass="root-menu" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gimnasio.gympjv.MenuMonitorController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="56.0" spacing="14.0" styleClass="topbar">
            <padding>
                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
            </padding>
            <children>
                <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                    <image><Image url="@../img/logo.png" /></image>
                </ImageView>
                <Label styleClass="topbar-titulo" text="Pedro J Villa" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblFecha" styleClass="topbar-fecha" text="-" />
                <Label styleClass="topbar-usuario" text="Monitor:" />
                <Label fx:id="lblUsuario" styleClass="topbar-usuario-nombre" text="-" />
                <Label fx:id="lblEspecialidad" styleClass="topbar-rol-valor" text="-" />
                <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#onCerrarSesion" styleClass="btn-cerrar-sesion" text="Cerrar sesion" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="195.0" spacing="4.0" styleClass="sidebar">
            <padding>
                <Insets bottom="16.0" left="12.0" right="12.0" top="12.0" />
            </padding>
            <children>
                <Label styleClass="sidebar-seccion" text="MIS CLASES" />
                <Button fx:id="btnMisClases" mnemonicParsing="false" onAction="#onMisClases" prefWidth="175.0" styleClass="btn-sidebar" text="Mis clases" />
                <Button fx:id="btnAsistencia" mnemonicParsing="false" onAction="#onAsistencia" prefWidth="175.0" styleClass="btn-sidebar" text="Asistencia" />
                <Button fx:id="btnReservas" mnemonicParsing="false" onAction="#onReservas" prefWidth="175.0" styleClass="btn-sidebar" text="Reservas" />

                <Label styleClass="sidebar-seccion" text="MIS SOCIOS" />
                <Button fx:id="btnMisSocios" mnemonicParsing="false" onAction="#onMisSocios" prefWidth="175.0" styleClass="btn-sidebar" text="Socios asignados" />
                <Button fx:id="btnMisDietas" mnemonicParsing="false" onAction="#onMisDietas" prefWidth="175.0" styleClass="btn-sidebar" text="Planes de dieta" />
                <Button fx:id="btnSesionesPersonales" mnemonicParsing="false" onAction="#onSesionesPersonales" prefWidth="175.0" styleClass="btn-sidebar" text="Sesiones personales" />
            </children>
        </VBox>
    </left>

    <bottom>
        <AnchorPane prefHeight="28.0" styleClass="footer">
            <children>
                <Label styleClass="marca-agua-footer" text="Ayoub Atidi Belbaz" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="6.0" />
            </children>
        </AnchorPane>
    </bottom>
</BorderPane>
