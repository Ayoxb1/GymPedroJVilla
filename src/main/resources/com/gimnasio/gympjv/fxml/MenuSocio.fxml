<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" prefHeight="700.0" prefWidth="1100.0" styleClass="root-menu" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gimnasio.gympjv.MenuSocioController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="56.0" spacing="14.0" styleClass="topbar">
            <padding>
                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
            </padding>
            <children>
                <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                    <image><Image url="@../img/logo.png" /></image>
                </ImageView>
                <Label styleClass="topbar-titulo" text="Pedro J Villa" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblFecha" styleClass="topbar-fecha" text="-" />
                <Label styleClass="topbar-usuario" text="Socio:" />
                <Label fx:id="lblUsuario" styleClass="topbar-usuario-nombre" text="-" />
                <Label fx:id="lblRol" styleClass="topbar-rol-valor" text="" />
                <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#onCerrarSesion" styleClass="btn-cerrar-sesion" text="Cerrar sesion" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="195.0" spacing="4.0" styleClass="sidebar">
            <padding>
                <Insets bottom="16.0" left="12.0" right="12.0" top="12.0" />
            </padding>
            <children>
                <Label styleClass="sidebar-seccion" text="MI PERFIL" />
                <Button fx:id="btnDatos" mnemonicParsing="false" onAction="#onDatos" prefWidth="175.0" styleClass="btn-sidebar" text="Mis datos" />
                <Button fx:id="btnSuscripcion" mnemonicParsing="false" onAction="#onSuscripcion" prefWidth="175.0" styleClass="btn-sidebar" text="Mi suscripcion" />
                <Button fx:id="btnDieta" mnemonicParsing="false" onAction="#onDieta" prefWidth="175.0" styleClass="btn-sidebar" text="Mi plan de dieta" />

                <Label styleClass="sidebar-seccion" text="ACTIVIDAD" />
                <Button fx:id="btnReservar" mnemonicParsing="false" onAction="#onReservar" prefWidth="175.0" styleClass="btn-sidebar" text="Reservar clase" />
                <Button fx:id="btnReservas" mnemonicParsing="false" onAction="#onReservas" prefWidth="175.0" styleClass="btn-sidebar" text="Mis reservas" />
                <Button fx:id="btnComprarBono" mnemonicParsing="false" onAction="#onComprarBono" prefWidth="175.0" styleClass="btn-sidebar" text="Comprar bono" />
                <Button fx:id="btnQR" mnemonicParsing="false" onAction="#onQR" prefWidth="175.0" styleClass="btn-sidebar" text="Mi codigo QR" />
                <Button fx:id="btnHistorial" mnemonicParsing="false" onAction="#onHistorial" prefWidth="175.0" styleClass="btn-sidebar" text="Historial de compras" />
            </children>
        </VBox>
    </left>

    <bottom>
        <AnchorPane prefHeight="28.0" styleClass="footer">
            <children>
                <Label styleClass="marca-agua-footer" text="Ayoub Atidi Belbaz" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="6.0" />
            </children>
        </AnchorPane>
    </bottom>
</BorderPane>
